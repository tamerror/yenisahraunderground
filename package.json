{
  "name": "yenisahra-underground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mahalle sokaklarında gezip item toplama oyunu (Street View / 3D OSM)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:artifact": "vite build --config vite.artifact.config.ts && node tools/make-artifact.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
